CompileList {
	A = "constructor/esse.cxx"
	B = "constructor/ioss.cxx"
	C = "constructor/kernel.cxx"
	D = "constructor/esse_cc.cxx"
	E = "constructor/esse_scaenaria.cxx"
	F = "constructor/esse_rsrc.cxx"
	G = "constructor/esse_link.cxx"
	H = "constructor/esse_reconf.cxx"
	I = "constructor/esse_devenv.cxx"
}
"-Debug" {
	CompileList {
		AA = "constructor/esse.loc.ertbs"
	}
	Attachments {
		A {
			From = "constructor/esse.loc.ini"
			To = "esse.loc.ini"
		}
		B {
			From = "constructor/esse.ini"
			To = "esse.ini"
		}
	}
}
UseVersionDefines = true
VersionInformation {
	ApplicationIdentifier = "ESSE"
	ApplicationName = "Engine Constructor SubSystemae"
	CompanyIdentifier = "EngineSoftware"
	CompanyName = "Engine Software"
	Copyright = "© Engine Software. 2026"
	InternalName = "esse"
	Version = "2.99.7.16"
}