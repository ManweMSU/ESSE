CoClassis = "Specialis"
CoNomen = "ESSE Modulus Graphicae [Linux]"
CoAuthor = "Engine Software"
CoVersio = "2.0.0.1"
CoIndentitas = "graphica-linux"
CoSystema { A = "Linux" }
CoImplantatioAbstractionis = "graphica"
CoImplantatioDefalta = true
CoModuliRequisiti { A = "cor" B = "graphica" C = "formationes" }
CoTituli { A = "api" }
CoDefini {
	ESSE_MODULUS_GRAPHICA_VULKAN = true
}
CoCompila {
	A = "Graphica.cxx"
	B = "CairoDL.cxx"
	C = "DeviceCairo.cxx"
	D = "DeviceWindowedCairo.cxx"
	E = "Vulkan.cxx"
	F = "Vulkan2D.cxx"
}