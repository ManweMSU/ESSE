CoClassis = "Communalis"
CoNomen = "Engine Runtime"
CoAuthor = "Engine Software"
CoVersio = "2.0.0.1"
CoIndentitas = "EngineRuntime"
CoModuliRequisiti { A = "cor" B = "auxilia" C = "consolatorium" D = "imagines" }
CoDefini { ENGINE_RUNTIME = true }
CoTituli { A = "." }
CoCompila {
	A = "EngineBase.cpp"
	B = "Streaming.cpp"
	CA = "PlatformDependent/Assembly.cpp"
	CB = "PlatformDependent/Base.cpp"
	CC = "PlatformDependent/Console.cpp"
	CD = "PlatformDependent/DynamicLibrary.cpp"
	CE = "PlatformDependent/Process.cpp"
	CF = "PlatformDependent/Shell.cpp"
	CG = "PlatformDependent/SystemIO.cpp"
	CH = "PlatformDependent/SystemIPC.cpp"
	CI = "PlatformDependent/Threading.cpp"
	DA = "PlatformSpecific/UnixFileAccess.cpp"
	EA = "Miscellaneous/ConsoleServices.cpp"
	EB = "Miscellaneous/DynamicString.cpp"
	EC = "Miscellaneous/Encoding.cpp"
	ED = "Miscellaneous/FileServices.cpp"
	EE = "Miscellaneous/ThreadPool.cpp"
	EF = "Miscellaneous/Time.cpp"
	FA = "Syntax/Grammar.cpp"
	FB = "Syntax/Tokenization.cpp"
	FC = "Syntax/Regular.cpp"
	GA = "Storage/Registry.cpp"
	GB = "Storage/StringTable.cpp"
	GC = "Storage/TextRegistry.cpp"
	GD = "Storage/TextRegistryGrammar.cpp"
}